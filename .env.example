# SQLite (default, zero-setup, good for demo/prototype use)
DATABASE_URL=sqlite:///./manadwar.db

# To switch to Postgres later, comment the line above and uncomment/edit this:
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<dbname>

# JWT signing secret. REQUIRED for real use -- generate your own random
# value (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
# and never commit the real value. If unset, a dev-only insecure default
# is used and the app will log a warning.
JWT_SECRET_KEY=change-this-to-a-random-secret-before-real-use

# How long a login token stays valid, in minutes.
JWT_EXPIRE_MINUTES=60

# Where complaint photos are stored (default: an "uploads" folder in the project).
# UPLOAD_DIR=
