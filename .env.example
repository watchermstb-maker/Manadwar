# ManaDwar settings. Copy this file to ".env" and edit the copy.

# --- Mode -------------------------------------------------------------------
# development = demo-friendly: API docs on, `python -m app.seed` allowed, and a random
#               secret is used if you have not set one (people are signed out on restart).
# production  = (default when this line is absent) the app REFUSES to start without a
#               real JWT_SECRET_KEY, serves no API docs and will not create demo accounts.
MANADWAR_ENV=development

# --- Database ---------------------------------------------------------------
# SQLite (zero setup). IMPORTANT: keep the file OUTSIDE OneDrive/Dropbox/Google Drive --
# cloud sync can corrupt a database that is being written. Example (Windows):
# DATABASE_URL=sqlite:///C:/ManaDwarData/manadwar.db
DATABASE_URL=sqlite:///./manadwar.db
# To switch to Postgres later:
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<dbname>

# --- Secrets (REQUIRED in production) ---------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# Never commit the real values.
# JWT_SECRET_KEY=
# Key used to fingerprint Aadhaar numbers (keep it safe; changing it means previously
# registered staff must be re-entered). Defaults to a value derived from JWT_SECRET_KEY.
# AADHAAR_HASH_KEY=

# --- Sessions ---------------------------------------------------------------
JWT_EXPIRE_MINUTES=60
# Guards stay signed in for a whole shift (minutes).
GUARD_JWT_EXPIRE_MINUTES=720

# --- Other ------------------------------------------------------------------
# Where photos are stored (default: an "uploads" folder in the project).
# UPLOAD_DIR=
# Society time zone as minutes ahead of UTC (India = 330).
# SOCIETY_UTC_OFFSET_MINUTES=330
# Set to 1 only when running behind a trusted reverse proxy (so client IPs are read correctly).
# TRUST_PROXY=0
# Show the interactive API docs even in production (not recommended).
# ENABLE_DOCS=0
